# ESPAirspy editor configuration
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{html,css,js,yml,yaml}]
indent_style = space
indent_size = 2

[*.{sh,bat}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
